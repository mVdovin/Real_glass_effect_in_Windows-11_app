<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WpfApp1" Height="800" Width="700"
        WindowStyle="None" AllowsTransparency="True" 
        WindowStartupLocation="CenterScreen"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
        xmlns:local="clr-namespace:WpfApp1" Background="Transparent">

    <Window.Resources>

        <DataTemplate x:Key="ChatItemTemplate">
            <Grid Margin="16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="48" Height="48" Fill="{Binding AvatarBrush}"/>
                <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" 
                               Margin="0,0,0,2" 
                               Foreground="{DynamicResource  contentsTitleText}" 
                               FontSize="14" FontWeight="Bold"
                               TextOptions.TextFormattingMode="Display"
                               TextOptions.TextRenderingMode="ClearType"/>
                    <TextBlock Text="{Binding LastMsg}" 
                               Margin="2,0,0,0" 
                               Foreground="{DynamicResource  contentsPreviewText}" 
                               FontSize="12" 
                               TextTrimming="CharacterEllipsis"
                               TextOptions.TextFormattingMode="Display"
                               TextOptions.TextRenderingMode="ClearType"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="ChatItemStyle" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Наведение -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource mainMenuHover}"/>
                            </Trigger>
                            <!-- Выделение -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource mainMenuActive}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ButtomLightTheme" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <StackPanel VerticalAlignment="Center">
                            <Grid>
                                <Border>
                                    <ui:SymbolIcon x:Name="WeatherSunny16" Symbol="WeatherSunny16" FontSize="20" Foreground="{DynamicResource mainText}"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WeatherSunny16" Property="Foreground" Value="{DynamicResource mainText}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <local:NegativeValueConverter x:Key="NegConverter"/>
        <local:SizeToRectConverter x:Key="SizeToRectConverter"/>
        
    </Window.Resources>

    <Border Background="{DynamicResource mainBackground}" CornerRadius="9" BorderBrush="{DynamicResource mainBorderBrush}" BorderThickness="1">
        <Grid x:Name="MainContainer" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseDown="Header_MouseDown">
                <Border BorderBrush="{DynamicResource mainPanel_bottom_border}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="ThemeSwither" Width="45" Height="32" Style="{StaticResource ButtomLightTheme}"/>
                        <Button Cursor="Hand" Content="—" Click="Min_Click" Width="45" Height="32" Background="Transparent" Foreground="{DynamicResource  mainText}" BorderThickness="0"/>
                        <Button Cursor="Hand" Content="✕" Click="Close_Click" Width="45" Height="32" Background="Transparent" Foreground="{DynamicResource mainText}" BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="All_cont" Grid.Row="1">
                <Grid x:Name="ContentArea">
                    <Grid.OpacityMask>
                        <VisualBrush>
                            <VisualBrush.Visual>
                                <Border Background="#1A1A1A" Width="{Binding ActualWidth, ElementName=ContentArea}" Height="{Binding ActualHeight, ElementName=ContentArea}" CornerRadius="0,0,9,9" />
                            </VisualBrush.Visual>
                        </VisualBrush>
                    </Grid.OpacityMask>
                    <ScrollViewer x:Name="MainScroll" 
                                  Background="Transparent"
                                  CanContentScroll="False" 
                                  VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="MainScroll_PreviewMouseWheel"
                                  Style="{DynamicResource ModernScrollStyle}">

                        <Frame x:Name="RootFrame" NavigationUIVisibility="Hidden" Background="{DynamicResource contentsBackground}" VirtualizingStackPanel.IsVirtualizing="True" />
                    </ScrollViewer>
                    <Border Height="400" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                        <UniformGrid Columns="2">
                            <Image Source="/Снимок экрана 2026-06-11 180020.png" Stretch="Uniform"/>
                            <Image Source="/PXL_20210915_104801271.jpg" Stretch="Uniform" VerticalAlignment="Bottom"/>
                        </UniformGrid>
                    </Border>
                </Grid>

                <Border x:Name="mainMenu" Background="#2D2D30" CornerRadius="9" Width="210"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,13,0"
                    BorderBrush="#3F3F46" BorderThickness="1">

                <StackPanel Margin="6">
                    <TextBlock Text="НАЛАШТУВАННЯ ОБ'ЄКТУ" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                    <!-- -->
                    <TextBlock Text="Розмір об'єкта:" Foreground="#CCCCCC" FontSize="12"/>
                    <DockPanel>
                        <TextBlock Text="{Binding ElementName=SizeSlider, Path=Value, StringFormat={}{0:0}}" Foreground="White" DockPanel.Dock="Right" Width="30" TextAlignment="Right"/>
                        <Slider x:Name="SizeSlider" Minimum="50" Maximum="350" Value="150" TickFrequency="1" IsSnapToTickEnabled="True" />
                    </DockPanel>
                    <!-- -->
                    <TextBlock x:Name="CornerRadiusLabel" Text="Закруглення кутів:" Foreground="#CCCCCC" FontSize="12"/>
                    <DockPanel Margin="0,0,0,0">
                        <TextBlock x:Name="CornerValueText" Text="{Binding ElementName=CornerSlider, Path=Value, StringFormat={}{0:0}}" Foreground="White" DockPanel.Dock="Right" Width="30" TextAlignment="Right"/>
                        <Slider x:Name="CornerSlider" Minimum="0" Maximum="175" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" />
                    </DockPanel>
                    <!-- -->
                    <Separator Background="#3F3F46" Margin="0,0,0,0"/>
                    <!-- -->
                    <TextBlock Text="Форма об'єкта:" Foreground="#CCCCCC" FontSize="12"/>
                    <UniformGrid Columns="2">
                        <RadioButton x:Name="RbSquare" Content="Квадрат" Foreground="White" IsChecked="True">
                            <RadioButton.Triggers>
                                <EventTrigger RoutedEvent="RadioButton.Checked">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="MyLensEffect" 
                                     Storyboard.TargetProperty="ShapeType" 
                                     To="0.0" 
                                     Duration="0:0:0" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </RadioButton.Triggers>
                        </RadioButton>
                        <!-- -->
                        <RadioButton x:Name="RbCircle" Content="Круг" Foreground="White">
                            <RadioButton.Triggers>
                                <EventTrigger RoutedEvent="RadioButton.Checked">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="MyLensEffect" 
                                     Storyboard.TargetProperty="ShapeType" 
                                     To="1.0" 
                                     Duration="0:0:0" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </RadioButton.Triggers>
                        </RadioButton>
                    </UniformGrid>
                    <!-- -->
                    <Separator Background="#3F3F46" Margin="0,0,0,0"/>
                    <!-- -->
                    <TextBlock Text="Ширина краю (EdgeWidth):" Foreground="#CCCCCC" FontSize="12"/>
                    <DockPanel >
                        <TextBlock Text="{Binding ElementName=EdgeWidthSlider, Path=Value, StringFormat={}{0:0.00}}" Foreground="White" DockPanel.Dock="Right" Width="40" TextAlignment="Right"/>
                        <Slider x:Name="EdgeWidthSlider" Minimum="0.1" Maximum="15.0" Value="0.80" SmallChange="0.01" LargeChange="0.1"/>
                    </DockPanel>
                    <!-- -->
                    <TextBlock Text="Сила відображення (ReflectPower):" Foreground="#CCCCCC" FontSize="12"/>
                    <DockPanel >
                        <TextBlock Text="{Binding ElementName=ReflectPowerSlider, Path=Value, StringFormat={}{0:0.00}}" Foreground="White" DockPanel.Dock="Right" Width="40" TextAlignment="Right"/>
                        <Slider x:Name="ReflectPowerSlider" Minimum="0.0" Maximum="15.0" Value="0.10" SmallChange="0.01" LargeChange="0.1"/>
                    </DockPanel>
                    <!-- -->
                    <TextBlock Text="Спотворення (Distortion):" Foreground="#CCCCCC" FontSize="12"/>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding ElementName=DistortionSlider, Path=Value, StringFormat={}{0:0.00}}" Foreground="White" DockPanel.Dock="Right" Width="40" TextAlignment="Right"/>
                        <Slider x:Name="DistortionSlider" Minimum="0.0" Maximum="15.0" Value="0.01" SmallChange="0.01" LargeChange="0.1"/>
                    </DockPanel>
                    <!-- -->
                    <TextBlock Text="Зсув RGB (RGBShift):" Foreground="#CCCCCC" FontSize="12"/>
                    <DockPanel>
                        <TextBlock Text="{Binding ElementName=RGBShiftSlider, Path=Value, StringFormat={}{0:0.000}}" Foreground="White" DockPanel.Dock="Right" Width="45" TextAlignment="Right"/>
                        <Slider x:Name="RGBShiftSlider" Minimum="0.000" Maximum="0.200" Value="0.005" SmallChange="0.001" LargeChange="0.005"/>
                    </DockPanel>
                    <!-- -->
                    <Separator Background="#3F3F46" Margin="0,0,0,0"/>
                    <!-- -->
                    <TextBlock Text="ЕФЕКТИ ТА ТІНІ" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center"/>
                    <!-- -->
                    <TextBlock Text="Інтенсивність розмиття:" Foreground="#CCCCCC" FontSize="12"/>
                    <DockPanel>
                        <TextBlock Text="{Binding ElementName=BlurSlider, Path=Value, StringFormat={}{0:0}}" Foreground="White" DockPanel.Dock="Right" Width="30" TextAlignment="Right"/>
                        <Slider x:Name="BlurSlider" Minimum="0" Maximum="20" Value="3" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    </DockPanel>
                    <!-- -->
                    <TextBlock Text="Розмиття тіні (BlurRadius):" Foreground="#CCCCCC" FontSize="12"/>
                    <DockPanel>
                        <TextBlock Text="{Binding ElementName=ShadowBlurSlider, Path=Value, StringFormat={}{0:0}}" Foreground="White" DockPanel.Dock="Right" Width="30" TextAlignment="Right"/>
                        <Slider x:Name="ShadowBlurSlider" Minimum="0" Maximum="30" Value="7" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    </DockPanel>
                    <!-- -->
                    <TextBlock Text="Зсув тіні (ShadowDepth):" Foreground="#CCCCCC" FontSize="12"/>
                    <DockPanel>
                        <TextBlock Text="{Binding ElementName=ShadowDepthSlider, Path=Value, StringFormat={}{0:0.0}}" Foreground="White" DockPanel.Dock="Right" Width="30" TextAlignment="Right"/>
                        <Slider x:Name="ShadowDepthSlider" Minimum="0" Maximum="15" Value="2.6" SmallChange="0.1" LargeChange="1"/>
                    </DockPanel>
                    <!-- -->
                    <TextBlock Text="Прозорість тіні (Opacity):" Foreground="#CCCCCC" FontSize="12"/>
                    <DockPanel>
                        <TextBlock Text="{Binding ElementName=ShadowOpacitySlider, Path=Value, StringFormat={}{0:0.00}}" Foreground="White" DockPanel.Dock="Right" Width="35" TextAlignment="Right"/>
                        <Slider x:Name="ShadowOpacitySlider" Minimum="0.0" Maximum="1.0" Value="0.40" SmallChange="0.05" LargeChange="0.1"/>
                    </DockPanel>
                    <!-- -->
                    <DockPanel>
                        <TextBlock Text="{Binding ElementName=GradientCheck, Path=IsChecked}" Foreground="Transparent" DockPanel.Dock="Right" Width="35" TextAlignment="Right"/>
                        <CheckBox x:Name="GradientCheck" IsChecked="True" Content="Градієнт" />
                    </DockPanel>
                </StackPanel>
            </Border>

            </Grid>



            <Canvas Grid.Row="1" x:Name="MainCanvas">
                <Border x:Name="Block1"
                        Grid.Row="1"
                        CornerRadius="{Binding ElementName=CornerSlider, Path=Value}"
                        BorderThickness="1.5"
                        Height="{Binding ElementName=SizeSlider, Path=Value}"
                        Width="{Binding ElementName=SizeSlider, Path=Value}"
                        BorderBrush="{DynamicResource GlassBorderBrush}"
                        Cursor="Hand"
                        MouseLeftButtonDown="DraggableBorder_MouseLeftButtonDown"
                        MouseMove="DraggableBorder_MouseMove"
                        MouseLeftButtonUp="DraggableBorder_MouseLeftButtonUp"
                        MouseRightButtonUp="Block1_MouseRightButtonUp"
                        RenderTransformOrigin="0.5,0.5" Background="Transparent">

                    <Border.Effect>
                        <DropShadowEffect BlurRadius="{Binding ElementName=ShadowBlurSlider, Path=Value}" 
                                          Direction="320" 
                                          ShadowDepth="{Binding ElementName=ShadowDepthSlider, Path=Value}" 
                                          Opacity="{Binding ElementName=ShadowOpacitySlider, Path=Value}"/>
                    </Border.Effect>

                    <Grid>
                        <Border x:Name="MyBorder" ClipToBounds="True">

                            <Border.Clip>
                                <RectangleGeometry 
                                        RadiusX="{Binding ElementName=CornerSlider, Path=Value}" 
                                        RadiusY="{Binding ElementName=CornerSlider, Path=Value}">
                                    <RectangleGeometry.Rect>
                                        <MultiBinding Converter="{StaticResource SizeToRectConverter}">
                                            <Binding ElementName="MyBorder" Path="ActualWidth" />
                                            <Binding ElementName="MyBorder" Path="ActualHeight" />
                                        </MultiBinding>
                                    </RectangleGeometry.Rect>
                                </RectangleGeometry>
                            </Border.Clip>

                            <Border.Effect>
                                <BlurEffect Radius="{Binding ElementName=BlurSlider, Path=Value}" KernelType="Gaussian" RenderingBias="Quality"/>
                            </Border.Effect>

                            <!-- -->

                            <Grid Margin="{Binding ElementName=BlurSlider, Path=Value, Converter={StaticResource NegConverter}}">
                                <Border x:Name="Myl15"
                                        local:LensHelper.IsLens="true" 
                                        local:LensHelper.LensCornerRadius="{Binding ElementName=CornerSlider, Path=Value}"
                                        local:LensHelper.VerticalOffset="32"
                                        local:LensHelper.TargetContent="{Binding ElementName=All_cont}">

                                    <Border.Effect>
                                        <local:LensEffect x:Name="MyLensEffect"
                                            EdgeWidth="{Binding ElementName=EdgeWidthSlider, Path=Value}"
                                            ReflectPower="{Binding ElementName=ReflectPowerSlider, Path=Value}"
                                            Distortion="{Binding ElementName=DistortionSlider, Path=Value}"
                                            RGBShift="{Binding ElementName=RGBShiftSlider, Path=Value}"
                                            ObjWidth="{Binding ElementName=Myl15, Path=ActualWidth}"
                                            ObjHeight="{Binding ElementName=Myl15, Path=ActualHeight}"/>
                                    </Border.Effect>

                                    <!--<Border.Background>
                                        <ImageBrush x:Name="DesktopBrush" Stretch="None" AlignmentX="Left" AlignmentY="Top"/>
                                    </Border.Background>-->

                                    <Border.Background>
                                        <VisualBrush Visual="{Binding ElementName=All_cont}"
                                                         Stretch="None" 
                                                         ViewboxUnits="Absolute"/>
                                    </Border.Background>

                                </Border>
                            </Grid>
                        </Border>

                        <Border CornerRadius="{Binding ElementName=CornerSlider, Path=Value}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ElementName=GradientCheck, Path=IsChecked}" Value="true">
                                            <Setter Property="Background" Value="{DynamicResource GlassBackground}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                    </Grid>
                </Border>
            </Canvas>




        </Grid>
    </Border>
</Window>