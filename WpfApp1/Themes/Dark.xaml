<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--main colors -->
    <SolidColorBrush x:Key="mainBackground" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="mainBorderBrush" Color="#FF484848"/>
    <SolidColorBrush x:Key="mainText" Color="White"/>
    <SolidColorBrush x:Key="mainTextHover" Color="Black"/>
    <SolidColorBrush x:Key="mainBackgroundHover" Color="#41393939"/>
    <SolidColorBrush x:Key="mainPanel_bottom_border" Color="#23FFFFFF"/>
    <!--contents colors -->
    <SolidColorBrush x:Key="contentsBackground" Color="#FF202020"/>
    <SolidColorBrush x:Key="contentsMessageText" Color="#9FFFFFFF"/>
    <SolidColorBrush x:Key="contentsTitleText" Color="White"/>
    <SolidColorBrush x:Key="contentsPreviewText" Color="#5FFFFFFF"/>
    <SolidColorBrush x:Key="contentsFullText" Color="#5FFFFFFF"/>
    <!--ItemsControl colors -->
    <SolidColorBrush x:Key="ItemsControlBackground" Color="#FF2B2B2B"/>
    <SolidColorBrush x:Key="ItemsBorderBrush" Color="#23FFFFFF"/>
    <SolidColorBrush x:Key="ItemsMessageText" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ItemsTitleText" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ItemsPreviewText" Color="#FF888888"/>
    <SolidColorBrush x:Key="ItemsFullText" Color="#7F000000"/>
    <SolidColorBrush x:Key="ItemsButtonHover" Color="#41393939"/>


    

    <!--controls colors -->

    <!--main menu colors -->
    <SolidColorBrush x:Key="mainMenuBackground" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="mainMenuBorderBrush" Color="#33FFFFFF"/>

    <SolidColorBrush x:Key="mainMenuHover" Color="#12DBDBDB"/>
    <SolidColorBrush x:Key="mainMenuActive" Color="#6F2E70A5"/>


    <SolidColorBrush x:Key="mainMenuIconActive" Color="#FF00A045"/>
    <SolidColorBrush x:Key="mainMenuIconDefault" Color="White"/>
    <SolidColorBrush x:Key="mainMenuTextActive" Color="#FF00A045"/>
    <SolidColorBrush x:Key="mainMenuTextDefault" Color="White"/>
    <!--behavior colors -->





    <!--glass textBox -->
    <Style x:Key="GlassyFormTextBox" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
        <Style.Resources>
            <SolidColorBrush x:Key="TextControlBackground" Color="#10393939"/>
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#8F2B2B2B"/>
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#71393939"/>
            <SolidColorBrush x:Key="TextControlForeground" Color="White"/>
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="White"/>
        </Style.Resources>
        <Setter Property="BorderBrush" Value="#2FFFFFFF"/>
    </Style>
    
    <!--glass border colors -->
    <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7CFFFFFF" Offset="0.0"/>
        <GradientStop Color="#30FFFFFF" Offset="0.5"/>
        <GradientStop Color="#70A1C4FD" Offset="1.0"/>
    </LinearGradientBrush>
    <!--glass Background colors -->
    <LinearGradientBrush x:Key ="GlassBackground"  StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#08FFFFFF" Offset="0.0"/>
        <GradientStop Color="#11FFFFFF" Offset="0.1"/>
        <GradientStop Color="#15FFFFFF" Offset="0.2"/>
        <GradientStop Color="#16FFFFFF" Offset="0.3"/>
        <GradientStop Color="#11FFFFFF" Offset="0.4"/>
        <GradientStop Color="#0DFFFFFF" Offset="0.5"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.6"/>
        <GradientStop Color="#08FFFFFF" Offset="0.7"/>
        <GradientStop Color="#05FFFFFF" Offset="0.8"/>
        <GradientStop Color="#03FFFFFF" Offset="0.9"/>
        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
    </LinearGradientBrush>
    
    
    
    



    <!--scroll style -->
    <SolidColorBrush x:Key="SBrush" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="SBackground" Color="Transparent"/>
    <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Rectangle" 
                        CornerRadius="3" 
                        Background="{DynamicResource SBrush}" 
                        Margin="0,0,2,0" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Rectangle" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ModernScrollStyle" TargetType="ScrollViewer">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollContentPresenter Grid.Column="0" Grid.Row="0" Margin="{TemplateBinding Padding}"/>

                        <ScrollBar x:Name="PART_VerticalScrollBar"
                               Grid.Column="1"
                               Value="{TemplateBinding VerticalOffset}"
                               Maximum="{TemplateBinding ScrollableHeight}"
                               ViewportSize="{TemplateBinding ViewportHeight}"
                               Visibility="{TemplateBinding VerticalScrollBarVisibility}"
                               Width="8" 
                               AutomationProperties.AutomationId="VerticalScrollBar">
                            <ScrollBar.Template>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid x:Name="TrackGrid" Background="{DynamicResource SBackground}">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.Thumb>
                                                <Thumb Style="{StaticResource ScrollThumbStyle}" />
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </ScrollBar.Template>
                        </ScrollBar>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>